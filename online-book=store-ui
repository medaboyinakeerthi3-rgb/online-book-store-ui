<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Online Book Store</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f4f4f4;
}

header{
    background:#333;
    color:white;
    text-align:center;
    padding:20px;
}

.books{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:20px;
    padding:30px;
}

.book{
    background:white;
    width:220px;
    padding:15px;
    border-radius:10px;
    text-align:center;
    box-shadow:0 0 10px rgba(0,0,0,0.2);
}

.book img{
    width:150px;
    height:220px;
    border-radius:5px;
}

.book h3{
    margin:10px 0;
}

.book p{
    font-size:18px;
    color:green;
    margin-bottom:10px;
}

button{
    background:#007BFF;
    color:white;
    border:none;
    padding:10px 20px;
    border-radius:5px;
    cursor:pointer;
}

button:hover{
    background:#0056b3;
}

footer{
    background:#333;
    color:white;
    text-align:center;
    padding:15px;
    margin-top:20px;
}
</style>

</head>
<body>

<header>
    <h1>📚 Online Book Store</h1>
</header>

<section class="books">

<div class="book">
    <img src="https://via.placeholder.com/150x220" alt="Java Book">
    <h3>Java Programming</h3>
    <p>₹499</p>
    <button>Add to Cart</button>
</div>

<div class="book">
    <img src="https://via.placeholder.com/150x220" alt="Python Book">
    <h3>Python Basics</h3>
    <p>₹399</p>
    <button>Add to Cart</button>
</div>

<div class="book">
    <img src="https://via.placeholder.com/150x220" alt="HTML Book">
    <h3>HTML & CSS</h3>
    <p>₹299</p>
    <button>Add to Cart</button>
</div>

<div class="book">
    <img src="https://via.placeholder.com/150x220" alt="JavaScript Book">
    <h3>JavaScript Guide</h3>
    <p>₹599</p>
    <button>Add to Cart</button>
</div>

<div class="book">
    <img src="https://via.placeholder.com/150x220" alt="C Book">
    <h3>C Programming</h3>
    <p>₹350</p>
    <button>Add to Cart</button>
</div>

<div class="book">
    <img src="https://via.placeholder.com/150x220" alt="SQL Book">
    <h3>SQL Essentials</h3>
    <p>₹450</p>
    <button>Add to Cart</button>
</div>

</section>

<footer>
    <p>© 2026 Online Book Store | All Rights Reserved</p>
</footer>

</body>
</html>
